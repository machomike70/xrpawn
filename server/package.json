{
  "name": "xrpawn-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "setup:testnet": "tsx src/scripts/setup-testnet.ts",
    "e2e": "tsx src/scripts/e2e.ts",
    "setup:multisig": "tsx src/scripts/setup-multisig.ts",
    "cosigner": "tsx --env-file=cosigner.env src/cosigner/index.ts",
    "test:unit": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "https-proxy-agent": "^9.1.0",
    "ripple-keypairs": "^3.1.0",
    "xrpl": "^5.3.0",
    "xumm-sdk": "^1.11.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
