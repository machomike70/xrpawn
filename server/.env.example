# Copy to .env (or run `npm run setup:testnet` to generate testnet accounts automatically)
PORT=8787
XRPL_NETWORK=testnet                 # testnet | devnet | mainnet
XRPL_WS_URL=wss://testnet.xrpl-labs.com   # mainnet: wss://xrplcluster.com or wss://s1.ripple.com
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173 # where Xaman sends users back after signing

# Platform accounts (KEEP SECRET). On mainnet use multisig + master key disabled, see README.
VAULT_SEED=
TREASURY_SEED=

# Comma-separated r-addresses allowed to use the admin panel
ADMIN_ADDRESSES=

# Xaman Platform API (https://apps.xumm.dev)
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Optional service keys
PRICE_FEED_API_KEY=           # sent as Bearer to PRICE_FEED_URL
BITHOMP_API_KEY=              # for PRICE_FEED=bithomp

# Terms (basis points: 100 = 1%)
PLATFORM_APR_BPS=2400
PLATFORM_MAX_DAYS=90
DEFAULT_LTV_BPS=4000
PLATFORM_EXPOSURE_CAP_DROPS=0
P2P_FEE_BPS=1000
FUNDING_WINDOW_HOURS=24
GRACE_HOURS=72
MARKET_FEE_BPS=200

# ---------------------------------------------------------------- Multisig vault (recommended before mainnet)
# `npm run setup:multisig` converts the vault to 2-of-3 multisig, disables its master key and fills these in
# (VAULT_SEED is then removed). The co-signer runs separately with cosigner.env: `npm run cosigner`.
VAULT_ADDRESS=
VAULT_SIGNER_SEED=
VAULT_QUORUM=2
COSIGNER_URL=http://localhost:8788
COSIGNER_TOKEN=

# ---------------------------------------------------------------- Live NFT prices
# PRICE_FEED: none | clio | bithomp | http   (see server/src/services/pricefeed.ts)
PRICE_FEED=none
CLIO_URL=                     # for clio, e.g. https://s1.ripple.com:51234 (mainnet) or your own Clio server
PRICE_FEED_URL=               # for http: https://example.com/floor/{issuer}/{taxon} -> {"floorDrops":"...","listings":N}
PRICE_FEED_MIN_LISTINGS=3     # thinner markets get no live price
PRICE_FEED_MAX_AGE_MIN=60     # live price older than this is ignored
PRICE_FEED_INTERVAL_MIN=15
PRICE_FEED_REQUIRED=0         # 1 = refuse pawn loans without a fresh live price
PRICE_FEED_BROKERS=           # marketplace broker addresses whose destination-locked listings count

# ---------------------------------------------------------------- TextRP alerts (optional)
# A TextRP bot account DMs alerts to users' wallets (@r...:synapse.textrp.io). Users opt in under the bell icon.
TEXTRP_HOMESERVER=https://synapse.textrp.io
TEXTRP_SERVER_NAME=synapse.textrp.io
TEXTRP_ACCESS_TOKEN=          # the bot's access token (starts with syt_)
