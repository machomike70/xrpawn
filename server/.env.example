# Copy to .env (or run `npm run setup:testnet` to generate testnet accounts automatically)
PORT=8787
XRPL_NETWORK=testnet                 # testnet | devnet | mainnet
XRPL_WS_URL=wss://testnet.xrpl-labs.com   # mainnet: wss://xrplcluster.com or wss://s1.ripple.com
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173 # where Xaman sends users back after signing

# Platform accounts (KEEP SECRET). On mainnet use multisig + master key disabled, see README.
VAULT_SEED=
TREASURY_SEED=

# Comma-separated r-addresses allowed to use the admin panel
ADMIN_ADDRESSES=

# Xaman Platform API (https://apps.xumm.dev)
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Optional service keys (reserved for price feeds / NFT metadata providers)
PRICE_FEED_URL=
PRICE_FEED_API_KEY=
BITHOMP_API_KEY=

# Terms (basis points: 100 = 1%)
PLATFORM_APR_BPS=2400
PLATFORM_MAX_DAYS=90
DEFAULT_LTV_BPS=4000
PLATFORM_EXPOSURE_CAP_DROPS=0
P2P_FEE_BPS=1000
FUNDING_WINDOW_HOURS=24
GRACE_HOURS=72
MARKET_FEE_BPS=200
